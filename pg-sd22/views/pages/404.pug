extends /layouts/base

block content
  section.section.error-shell
    .shell
      .error-card.reveal
        span.section-tag 404
        h1 The page you requested could not be found.
        p The route may have changed, the resource may have been removed, or the address may be invalid.
        .form-actions
          a.btn.btn-primary(href="/") Return home
          a.btn.btn-secondary(href="/skills") Browse skills
