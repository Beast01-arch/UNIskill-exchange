doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="description" content="UniSkill Exchange is a free skill exchange platform for people and organisations.")
    title= title ? title + ' · UniSkill Exchange' : 'UniSkill Exchange'
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous")
    link(href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Syne:wght@700;800&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/css/main.css")
  body(class=pageClass || "")
    .cursor-ring(aria-hidden="true")
    .cursor-dot(aria-hidden="true")
    include /partials/nav
    main.site-main
      include /partials/flash
      block content
    include /partials/footer
    script(src="/js/main.js" defer)
